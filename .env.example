# Nexora runtime configuration
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000

# Local file-backed store for development. Use postgres for production.
DATA_STORE=file
DATA_FILE=.data/nexora.json

# PostgreSQL adapter (wired via DATA_STORE=postgres; apply db/schema.sql first
# and validate in staging before production use)
DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora

# Redis-compatible job queue adapter placeholder (BullMQ in production)
QUEUE_DRIVER=memory

# Secret used for session token signing and webhook verification
SESSION_SECRET=replace-with-a-long-random-secret
WEBHOOK_SECRET=replace-with-provider-webhook-secret

# Object storage: local or s3
FILE_STORAGE=local
FILE_DIR=.data/files

# AI provider abstraction: mock | openai-compatible
AI_PROVIDER=mock
AI_API_URL=
AI_API_KEY=
AI_MODEL=nexora-default

# Seed password applied when the local data file is first created
SEED_PASSWORD=redacted-password

# Public base URL for generated API docs and the Electron wrapper
API_BASE_URL=http://localhost:4000

# CORS: CORS_ORIGIN is the variable the server reads today. ALLOWED_ORIGINS is
# included as a documented alias for future deployment tooling.
CORS_ORIGIN=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:4000

# Reserved: the running limiter uses fixed 60s windows (12 auth / 120 webhook /
# 600 general requests). These values are not read by the current runtime.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# Reserved: sessions currently use a fixed 12-hour TTL in core/auth.ts.
SESSION_TTL_HOURS=12

# Optional provider credentials. Channel adapters read WEBHOOK_SECRET_<PROVIDER>
# for signature checks and <PROVIDER>_TOKEN / <PROVIDER>_SEND_URL for delivery.
WEBHOOK_SECRET_TELEGRAM=
WEBHOOK_SECRET_WHATSAPP=
TELEGRAM_BOT_TOKEN=
TELEGRAM_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TOKEN=

# Reserved: notifications are in-app/desktop only; no SMTP transport is wired.
SMTP_URL=

# Reserved observability endpoints: no Sentry/OTel SDK is wired into the app.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
