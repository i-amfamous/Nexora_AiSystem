# Nexora runtime configuration — PRODUCTION TEMPLATE
# Copy to .env and replace every placeholder before starting the stack.
# Generate unique secrets, for example:
#   openssl rand -base64 48
# Production refuses to start with missing/short/placeholder secrets or without
# PostgreSQL, Redis and SMTP. No demo workspace or account is seeded.

NODE_ENV=production
PORT=4000
PUBLIC_URL=https://nexora.example.com
API_BASE_URL=https://nexora.example.com
CORS_ORIGIN=https://nexora.example.com
ALLOWED_ORIGINS=https://nexora.example.com

# PostgreSQL (used by docker-compose.yml and the migration service)
POSTGRES_USER=nexora
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DB=nexora
DATA_STORE=postgres
DATABASE_URL=postgresql://nexora:replace-with-a-long-random-secret@postgres:5432/nexora

# Redis/BullMQ background queue. QUEUE_CONCURRENCY controls worker parallelism.
QUEUE_DRIVER=redis
REDIS_URL=redis://redis:6379
QUEUE_CONCURRENCY=5

# Required secrets. Never reuse these values across environments.
SESSION_SECRET=replace-with-a-long-random-secret
WEBHOOK_SECRET=replace-with-provider-webhook-secret
FILE_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Transactional email for password resets and invitations.
SMTP_URL=smtps://replace-with-user:replace-with-password@smtp.example.com:465
SMTP_FROM=no-reply@nexora.example.com

# Object storage: local (persistent volume) or s3 (adapter-selected deployment).
FILE_STORAGE=local
FILE_DIR=.data/files

# AI provider abstraction: mock for local verification, openai-compatible in production.
AI_PROVIDER=mock
AI_API_URL=
AI_API_KEY=
AI_MODEL=nexora-default

# Backups run inside the backend container on this interval. 0 disables scheduling.
BACKUP_INTERVAL_HOURS=24
BACKUP_DIR=.data/backups
DATA_FILE=.data/nexora.json

# HTTPS is forced in production: REQUIRE_HTTPS=true and SEED_DEMO=false are set
# by the runtime and cannot be overridden.

# Optional provider credentials. Channel adapters read WEBHOOK_SECRET_<PROVIDER>
# for signature checks and <PROVIDER>_TOKEN / <PROVIDER>_SEND_URL for delivery.
WEBHOOK_SECRET_TELEGRAM=
WEBHOOK_SECRET_WHATSAPP=
TELEGRAM_BOT_TOKEN=
TELEGRAM_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TOKEN=

# Reserved observability endpoints. Structured JSON logs are always emitted;
# Sentry/OTel SDK exporters are not bundled in this release.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Development-only zero-setup alternative (do not use with NODE_ENV=production):
#   NODE_ENV=development DATA_STORE=file QUEUE_DRIVER=memory npm start
# The dev file store seeds the demo workspace owner@example.test /
# redacted-password, and reset tokens are printed to the console instead of emailed.
